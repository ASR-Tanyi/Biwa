{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux, AddressSanitizer + UBSan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BIWA_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux, ThreadSanitizer",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BIWA_SANITIZE": "thread"
      }
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-mingw.cmake"
    },
    {
      "name": "win-base",
      "hidden": true,
      "inherits": "mingw-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-debug",
      "displayName": "Windows debug (llvm-mingw)",
      "inherits": "win-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-release",
      "displayName": "Windows release with debug info (llvm-mingw)",
      "inherits": "win-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "cross-base",
      "hidden": true,
      "inherits": "mingw-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "cross-debug",
      "displayName": "Windows debug, cross-built on Linux (llvm-mingw, tests under Wine)",
      "inherits": "cross-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "cross-release",
      "displayName": "Windows release, cross-built on Linux (llvm-mingw, tests under Wine)",
      "inherits": "cross-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "lint",
      "displayName": "Lint: clang-tidy on every Biwa target, format check",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BIWA_CLANG_TIDY": "clang-tidy"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan"
    },
    {
      "name": "win-debug",
      "configurePreset": "win-debug"
    },
    {
      "name": "win-release",
      "configurePreset": "win-release"
    },
    {
      "name": "cross-debug",
      "configurePreset": "cross-debug"
    },
    {
      "name": "cross-release",
      "configurePreset": "cross-release"
    },
    {
      "name": "lint",
      "configurePreset": "lint",
      "targets": [
        "biwa_format_check",
        "all"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-asan",
      "inherits": "base",
      "configurePreset": "linux-asan",
      "environment": {
        "ASAN_OPTIONS": "alloc_dealloc_mismatch=0"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "base",
      "configurePreset": "linux-tsan"
    },
    {
      "name": "wine",
      "hidden": true,
      "inherits": "base",
      "environment": {
        "WINEDEBUG": "-all"
      }
    },
    {
      "name": "win-debug",
      "inherits": "base",
      "configurePreset": "win-debug"
    },
    {
      "name": "win-release",
      "inherits": "base",
      "configurePreset": "win-release"
    },
    {
      "name": "cross-debug",
      "inherits": "wine",
      "configurePreset": "cross-debug"
    },
    {
      "name": "cross-release",
      "inherits": "wine",
      "configurePreset": "cross-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux-debug"
        },
        {
          "type": "build",
          "name": "linux-debug"
        },
        {
          "type": "test",
          "name": "linux-debug"
        }
      ]
    },
    {
      "name": "linux-asan",
      "steps": [
        {
          "type": "configure",
          "name": "linux-asan"
        },
        {
          "type": "build",
          "name": "linux-asan"
        },
        {
          "type": "test",
          "name": "linux-asan"
        }
      ]
    },
    {
      "name": "linux-tsan",
      "steps": [
        {
          "type": "configure",
          "name": "linux-tsan"
        },
        {
          "type": "build",
          "name": "linux-tsan"
        },
        {
          "type": "test",
          "name": "linux-tsan"
        }
      ]
    },
    {
      "name": "win-debug",
      "steps": [
        {
          "type": "configure",
          "name": "win-debug"
        },
        {
          "type": "build",
          "name": "win-debug"
        },
        {
          "type": "test",
          "name": "win-debug"
        }
      ]
    },
    {
      "name": "win-release",
      "steps": [
        {
          "type": "configure",
          "name": "win-release"
        },
        {
          "type": "build",
          "name": "win-release"
        },
        {
          "type": "test",
          "name": "win-release"
        }
      ]
    },
    {
      "name": "cross-debug",
      "steps": [
        {
          "type": "configure",
          "name": "cross-debug"
        },
        {
          "type": "build",
          "name": "cross-debug"
        },
        {
          "type": "test",
          "name": "cross-debug"
        }
      ]
    },
    {
      "name": "cross-release",
      "steps": [
        {
          "type": "configure",
          "name": "cross-release"
        },
        {
          "type": "build",
          "name": "cross-release"
        },
        {
          "type": "test",
          "name": "cross-release"
        }
      ]
    },
    {
      "name": "lint",
      "steps": [
        {
          "type": "configure",
          "name": "lint"
        },
        {
          "type": "build",
          "name": "lint"
        }
      ]
    }
  ]
}
